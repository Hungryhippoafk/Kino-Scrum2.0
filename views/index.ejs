<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/styles.css">
    
    
    <title><%= title %></title>
</head>
<body>
    <header class="header">
        <div class="header__logo">
            <h1 class="header__logo-title">Kino Kvikkjokk</h1>
        </div>
        <nav class="header__nav">
            <ul class="header__nav-list">
                <li class="header__nav-item" id="header__menu">Menu</li>
                <li class="header__nav-item" id="header__children-movies">Children Movies</li>
                <li class="header__nav-item" id="header__events">Events</li>
                <li class="header__nav-item" id="header__about-us">About Us</li>
                <li class="header__nav-item" id="header__login">Login</li>
            </ul>
        </nav>
    </header>
    <main class="main">
        <div class="search__container">
            <label class="search__label" for="search">Search</label>
            <input class="search__input" type="text" maxlength="60" name="search" placeholder="Search..." />
            <button class="search__clear" type="button">Clear</button>
        </div>
        <button class="mobile__filter-menu">Filter Menu</button>
        <div class="filter-btn__container">
            <button class="filter-btn filter-btn--today" type="button">Today</button>
            <button class="filter-btn filter-btn--tomorrow" type="button">Tomorrow</button>
            <button class="filter-btn filter-btn--other" type="button">Other</button>
        </div>
        <div class="date-filter__wrapper">
            <ul class="date-filter__list"></ul>
        </div>
        <div class="filter-genre__container">
            <select class="filter-genre__dropdown">
                <option value="all" class="filter-genre__dropdown-all">All</option>
                <option value="Romance" class="filter-genre__dropdown-romance">Romance</option>
                <option value="Action" class="filter-genre__dropdown-action">Action</option>
                <option value="Horror" class="filter-genre__dropdown-horror">Horror</option>
                <option value="Kids" class="filter-genre__dropdown-kids">Kids</option>
                <option value="Comedy" class="filter-genre__dropdown-comedy">Comedy</option>
            </select>
        </div>
        <div class="movie__wrapper">
            <% if (movies && movies.length) { %>
                <% movies.forEach(movie => { %>
                    <div class="movie">
                        <a href="/movies/<%= movie.id %>">
                            <h2><%= movie.attributes.title %></h2>
                            <img src="<%= movie.attributes.image.url %>" alt="<%= movie.attributes.title %>">
                            <p><%= movie.attributes.intro %></p>
                        </a>
                    </div>
                <% }) %>
            <% } else { %>
                <p>No movies available.</p>
            <% } %>
        </div>
        
        <div class="filter-btn__container">
            <button class="filter-btn__show-less" type="button">Show Less</button>
            <button class="filter-btn__show-all" type="button">Show All</button>
        </div>
        <div class="movie-modal__container">
            <div class="movie-modal__content">
                <span class="movie-modal__close">X</span>
                <div class="movie-details">
                    <img class="movie-details__image" />
                    <h2 class="movie-details__title"></h2>
                    <p class="movie-details__id"></p>
                    <p class="movie-details__runtime"></p>
                    <p class="movie-details__description"></p>
                    <p class="movie-details__genres"></p>
                </div>
            </div>
        </div>
    </main>
    <footer class="footer">
        <div class="footer__social">
            <h3 class="footer__social-title">Follow Us</h3>
            <a class="footer__social-twitter" href="https://x.com/">
                <img src="/assets/images/icons/icons-twitter-white-512.png" alt="New Twitter Icon" />
            </a>
            <a class="footer__social-instagram" href="https://www.instagram.com/">
                <img src="/assets/images/icons/icons-instagram-white-512.png" alt="Instagram Icon" />
            </a>
            <a class="footer__social-youtube" href="https://www.youtube.com/">
                <img src="/assets/images/icons/icons-youtube-white-512.png" alt="Youtube Icon" />
            </a>
            <a class="footer__social-linkedin" href="https://www.linkedin.com/">
                <img src="/assets/images/icons/icons-linkedin-white-512.png" alt="LinkedIn Icon" />
            </a>
        </div>
        <div class="footer__contact">
            <h3 class="footer__contact-title">Contact Us</h3>
            <h6 class="footer__contact-info">info@kinokvikkjokk.com</h6>
            <h6 class="footer__contact-number">+123 456 7890</h6>
            <h6 class="footer__contact-mail1">support@kinokvikkjokk.com</h6>
            <h6 class="footer__contact-mail2">feedback@kinokvikkjokk.com</h6>
        </div>
        <div class="footer__find-Us">
            <h3 class="footer__find-Us-title">Find Us</h3>
            <h6 class="footer__find-Us-streetname">123 Movie St</h6>
            <h6 class="footer__find-Us-postalcode">12345</h6>
            <h6 class="footer__find-Us-country">Sweden</h6>
        </div>
        <div class="footer__partners">
            <h3 class="footer__partners-title">Our Partners</h3>
        </div>
    </footer>
    <script src="/Script/main.js"></script>
    <script src="/Script/fetch.js"></script>
    <script src="/Script/celebration-modal.js"></script>
    <script src="/Script/UI-movies.js"></script>
    <script src="/Script/filter.js"></script>
    <script src="/Script/UI-dateFilter.js"></script>
    <script src="/Script/ReplaceBackgroundKidsCinema.js"></script>
    <script src="/Script/moviecards-modal.js"></script>
    <script src="/Script/filter-genre.js"></script>
</body>
</html>
