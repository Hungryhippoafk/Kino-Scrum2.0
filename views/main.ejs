<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap" rel="stylesheet">
    <title><%= title %></title>
</head>
<body>
<header class="header">
    <div class="header__logo">
        <h1 class="header__logo-title">Kino Kvikkjokk</h1>
    </div>
    <nav class="header__nav">
        <ul class="header__nav-list">
            <li class="header__nav-item" id="header__menu">Menu</li>
            <li class="header__nav-item" id="header__children-movies">Children Movies</li>
            <li class="header__nav-item" id="header__events">Events</li>
            <li class="header__nav-item" id="header__about-us">About Us</li>
            <li class="header__nav-item" id="header__login">Login</li>
        </ul>
    </nav>
</header>
<main class="main">
    <%- body %>
</main>
<footer class="footer">
    <div class="footer__social">
        <h3 class="footer__social-title">Follow Us</h3>
        <a class="footer__social-twitter" href="https://x.com/">
            <img src="/assets/images/icons/icons-twitter-white-512.png" alt="New Twitter Icon">
        </a>
        <a class="footer__social-instagram" href="https://www.instagram.com/">
            <img src="/assets/images/icons/icons-instagram-white-512.png" alt="Instagram Icon">
        </a>
        <a class="footer__social-youtube" href="https://www.youtube.com/">
            <img src="/assets/images/icons/icons-youtube-white-512.png" alt="Youtube Icon">
        </a>
        <a class="footer__social-linkedin" href="https://www.linkedin.com/">
            <img src="/assets/images/icons/icons-linkedin-white-512.png" alt="LinkedIn Icon">
        </a>
    </div>
    <div class="footer__contact">
        <h3 class="footer__contact-title">Contact Us</h3>
        <h6 class="footer__contact-info">info@kinokvikkjokk.com</h6>
        <h6 class="footer__contact-number">+123 456 7890</h6>
        <h6 class="footer__contact-mail1">support@kinokvikkjokk.com</h6>
        <h6 class="footer__contact-mail2">feedback@kinokvikkjokk.com</h6>
    </div>
    <div class="footer__find-Us">
        <h3 class="footer__find-Us-title">Find Us</h3>
        <h6 class="footer__find-Us-streetname">123 Movie St</h6>
        <h6 class="footer__find-Us-postalcode">12345</h6>
        <h6 class="footer__find-Us-country">Sweden</h6>
    </div>
    <div class="footer__partners">
        <h3 class="footer__partners-title">Our Partners</h3>
    </div>
</footer>

</body>
</html>