<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/styles.css">
    <title><%= movie.attributes.title %> - Movie Details</title>
</head>
<body class="movie-details-page">
    <div class="movie-details-wrapper">
        <h1 class="movie-title"><%= movie.attributes.title %></h1>
        
        <% if (movie.attributes.image && movie.attributes.image.url) { %>
            <img src="<%= movie.attributes.image.url %>" alt="<%= movie.attributes.title %>" class="movie-image" />
        <% } else { %>
            <div class="movie-image-placeholder">No image available</div>
        <% } %>

        <p class="movie-description"><strong>Description:</strong> <%= movie.attributes.intro %></p>

        <div class="movie-links">
            <p><a href="/" class="back-to-list">Back to Movies List</a></p>
            <p><a href="/" class="back-to-home">Back to Home</a></p>
        </div>
    </div>
</body>
</html>
