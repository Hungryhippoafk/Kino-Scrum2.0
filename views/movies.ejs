<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/movie.css">
    <title>Movies List</title>
</head>
<body>
    <h1>Movies</h1>

    <% if (movies.length) { %>
        <ul>
            <% movies.forEach(movie => { %>
                <li class="movie-card">
                    <h2 class = "movie__title"><%= movie.attributes.title %></h2>
                    <% if (movie.attributes.image.url) { %>
                        <img src="<%= movie.attributes.image.url %>" alt="<%= movie.attributes.title %>" class="movie-image" />
                    <% } else { %>
                        <div class="movie-image-placeholder">No Image Available</div>
                    <% } %>
                    <p class="movie_description"><%= movie.attributes.intro %></p>
                    <a href="/movies/<%= movie.id %>" class="movie-details-button">See Details</a>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No movies available.</p>
    <% } %>

    <p><a href="/">Back to Home</a></p>
</body>
</html>
